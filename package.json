{
  "name": "agent-skillguard",
  "version": "1.1.0",
  "description": "Policy-as-code admission controller for AI agent skills and MCP tools with SkillBOM, lockfiles, and supply-chain baselines.",
  "type": "module",
  "homepage": "https://github.com/Gowrav-M/agent-skillguard#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gowrav-M/agent-skillguard.git"
  },
  "bugs": {
    "url": "https://github.com/Gowrav-M/agent-skillguard/issues"
  },
  "bin": {
    "agent-skillguard": "dist/cli.js"
  },
  "files": [
    "dist",
    "examples",
    "docs",
    "action.yml",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "prepack": "npm run build"
  },
  "keywords": [
    "agent-skills",
    "ai-agents",
    "skill-security",
    "supply-chain",
    "software-supply-chain",
    "prompt-injection",
    "ai-security",
    "ai-agents-security",
    "llm-security",
    "policy-as-code",
    "governance",
    "skill-registry",
    "devsecops",
    "claude-code",
    "codex",
    "cursor",
    "mcp",
    "sarif",
    "cli"
  ],
  "author": "Gowrav M",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.18.12",
    "eslint": "^9.39.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^4.1.7"
  }
}
